<mujoco model="wheel_leg_terrain">
  <compiler angle="radian" meshdir="../../car_urdf/meshes" autolimits="true"/>
  <option gravity="0 0 -9.81" timestep="0.001" integrator="Euler"/>

  <visual>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.65 0.65 0.65" specular="0.2 0.2 0.2"/>
  </visual>

  <default>
    <geom friction="1.2 0.005 0.0001" condim="3" solref="0.002 1" solimp="0.99 0.999 0.0001 0.5 2"/>
  </default>

  <asset>
    <mesh name="base_link" file="base_link.STL"/>
    <mesh name="left_leg" file="left_leg.STL"/>
    <mesh name="left_wheel" file="left_wheel.STL"/>
    <mesh name="right_leg" file="right_leg.STL"/>
    <mesh name="right_wheel" file="right_wheel.STL"/>
    
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1=".20 .30 .40" rgb2=".30 .42 .52"/>
    <material name="grid" texture="grid" texrepeat="20 5" reflectance="0.15"/>

    <!-- 起伏地形高度图资产 (4.0m x 1.0m, 高度范围 0 ~ 0.0065m = 6.5mm) -->
    <!-- hfield size: radius_x, radius_y, elevation_z, base_depth_z -->
    <hfield name="terrain_hfield" file="../../rl/terrain/rough_terrain.png" size="2.0 0.5 0.0065 0.01"/>
  </asset>

  <worldbody>
    <!-- 定向投射光（产生清晰侧光阴影，立体凸显地形凹凸） -->
    <light directional="true" pos="1.5 -0.8 1.5" dir="0.4 0.6 -1.2" castshadow="true" diffuse="0.95 0.95 0.95" specular="0.3 0.3 0.3"/>

    <!-- 地形中心位于 x=2.0m, y=0.0m，使 x 从 0.0 到 4.0m 连续覆盖 -->
    <geom name="terrain" type="hfield" hfield="terrain_hfield" pos="2.0 0.0 0.0" material="grid"/>
    
    <!-- 边界延伸基底地面，防止超出范围穿模 -->
    <geom name="ground_sub" type="plane" size="5 2 0.05" pos="2.0 0.0 -0.01" rgba="0.08 0.08 0.1 1"/>

    <!-- 赛道边界视觉护栏 (增强空间纵深感) -->
    <geom name="curb_left"  type="box" size="2.0 0.008 0.006" pos="2.0 0.08 0.005" rgba="0.7 0.7 0.7 0.9" contype="0" conaffinity="0"/>
    <geom name="curb_right" type="box" size="2.0 0.008 0.006" pos="2.0 -0.11 0.005" rgba="0.7 0.7 0.7 0.9" contype="0" conaffinity="0"/>

    <!-- 真实 3D 减速垄造型 (黄色圆弧减速带 + 黑色橡胶端盖，肉眼清晰立体，无碰撞纯视觉 contype=0 conaffinity=0) -->
    <!-- 障碍 1: 左轮单侧减速垄 (x=2.00, y=-0.0015, 高度 4.8mm) -->
    <geom name="bump1_arch" type="cylinder" size="0.06 0.020" pos="2.00 -0.0015 -0.0552" euler="90 0 0" rgba="0.95 0.75 0.10 1" contype="0" conaffinity="0"/>
    <geom name="bump1_capL" type="box" size="0.035 0.002 0.002" pos="2.00 0.019 0.002" rgba="0.18 0.18 0.20 1" contype="0" conaffinity="0"/>
    <geom name="bump1_capR" type="box" size="0.035 0.002 0.002" pos="2.00 -0.022 0.002" rgba="0.18 0.18 0.20 1" contype="0" conaffinity="0"/>

    <!-- 障碍 2: 右轮单侧减速垄 (x=2.30, y=-0.0335, 高度 4.8mm) -->
    <geom name="bump2_arch" type="cylinder" size="0.06 0.020" pos="2.30 -0.0335 -0.0552" euler="90 0 0" rgba="0.95 0.75 0.10 1" contype="0" conaffinity="0"/>
    <geom name="bump2_capL" type="box" size="0.035 0.002 0.002" pos="2.30 -0.013 0.002" rgba="0.18 0.18 0.20 1" contype="0" conaffinity="0"/>
    <geom name="bump2_capR" type="box" size="0.035 0.002 0.002" pos="2.30 -0.054 0.002" rgba="0.18 0.18 0.20 1" contype="0" conaffinity="0"/>

    <!-- 障碍 3: 左轮单侧减速垄 (x=2.60, y=-0.0015, 高度 4.8mm) -->
    <geom name="bump3_arch" type="cylinder" size="0.06 0.020" pos="2.60 -0.0015 -0.0552" euler="90 0 0" rgba="0.95 0.75 0.10 1" contype="0" conaffinity="0"/>
    <geom name="bump3_capL" type="box" size="0.035 0.002 0.002" pos="2.60 0.019 0.002" rgba="0.18 0.18 0.20 1" contype="0" conaffinity="0"/>
    <geom name="bump3_capR" type="box" size="0.035 0.002 0.002" pos="2.60 -0.022 0.002" rgba="0.18 0.18 0.20 1" contype="0" conaffinity="0"/>

    <!-- 障碍 4: 右轮单侧减速垄 (x=2.90, y=-0.0335, 高度 4.8mm) -->
    <geom name="bump4_arch" type="cylinder" size="0.06 0.020" pos="2.90 -0.0335 -0.0552" euler="90 0 0" rgba="0.95 0.75 0.10 1" contype="0" conaffinity="0"/>
    <geom name="bump4_capL" type="box" size="0.035 0.002 0.002" pos="2.90 -0.013 0.002" rgba="0.18 0.18 0.20 1" contype="0" conaffinity="0"/>
    <geom name="bump4_capR" type="box" size="0.035 0.002 0.002" pos="2.90 -0.054 0.002" rgba="0.18 0.18 0.20 1" contype="0" conaffinity="0"/>

    <!-- 障碍 5: 双轮全幅减速垄 (x=3.20, 全宽黄色警示减速排) -->
    <geom name="bump5_arch" type="cylinder" size="0.06 0.045" pos="3.20 -0.0175 -0.0555" euler="90 0 0" rgba="0.85 0.25 0.18 1" contype="0" conaffinity="0"/>
    <geom name="bump5_capL" type="box" size="0.035 0.002 0.002" pos="3.20 0.028 0.002" rgba="0.18 0.18 0.20 1" contype="0" conaffinity="0"/>
    <geom name="bump5_capR" type="box" size="0.035 0.002 0.002" pos="3.20 -0.063 0.002" rgba="0.18 0.18 0.20 1" contype="0" conaffinity="0"/>

    <!-- 机器人初始位置 (位于平坦起点 x=0.08, z=0.058) -->
    <body name="base_link" pos="0.08 0 0.058">
      <freejoint name="root"/>
      <inertial pos="-0.011138 -0.0175 0.001698" mass="0.16794" diaginertia="1.6308e-05 2.8107e-05 3.0344e-05"/>
      <geom type="mesh" rgba="0.85 0.45 0.15 1" mesh="base_link"/>
      
      <!-- Left Leg -->
      <body name="left_leg" pos="-0.0093975 0.0000 -0.0010809" quat="0.0159413 0.706926 0.706928 0.0159413">
        <inertial pos="-0.00175 -0.00163 0.018" quat="0.998982 0.0451138 0 0" mass="0.0087651" diaginertia="1.2889e-06 1.24217e-06 6.45868e-08"/>
        <joint name="left_hip_joint" range="-3.14 3.14" actuatorfrcrange="-10 10" axis="1 0 0" damping="0.001"/>
        <geom type="mesh" rgba="0.2 0.6 0.85 1" mesh="left_leg" contype="0" conaffinity="0"/>
        
        <!-- Left Wheel -->
        <body name="left_wheel" pos="-0.0015 -0.0036054 0.039837" quat="0.498403 0.501591 -0.498403 -0.501594">
          <inertial pos="0 0 -0.004057" quat="0.5 0.5 -0.5 0.5" mass="0.0022065" diaginertia="4.03259e-08 2.24677e-08 2.24677e-08"/>
          <joint name="left_wheel_joint" axis="0 0 -1" actuatorfrcrange="-10 10" damping="0.0001"/>
          <geom type="mesh" rgba="0.15 0.15 0.15 1" mesh="left_wheel" contype="0" conaffinity="0"/>
          <geom type="sphere" size="0.008" friction="1.5 0.01 0.0001" rgba="0 0 0 0" group="3"/>
        </body>
      </body>

      <!-- Right Leg -->
      <body name="right_leg" pos="-0.0093975 -0.0315 -0.0010809" quat="0.0159413 0.706926 0.706928 0.0159413">
        <inertial pos="-0.00175 -0.00163 0.018" quat="0.998982 0.0451138 0 0" mass="0.0087651" diaginertia="1.2889e-06 1.24217e-06 6.45868e-08"/>
        <joint name="right_hip_joint" range="-3.14 3.14" actuatorfrcrange="-10 10" axis="1 0 0" damping="0.001"/>
        <geom type="mesh" rgba="0.2 0.85 0.45 1" mesh="right_leg" contype="0" conaffinity="0"/>
        
        <!-- Right Wheel -->
        <body name="right_wheel" pos="-0.002 -0.0036054 0.039837" quat="0.501591 -0.498403 0.501594 -0.498403">
          <inertial pos="0 0 -0.004057" quat="0.5 0.5 -0.5 0.5" mass="0.0022065" diaginertia="4.03259e-08 2.24677e-08 2.24677e-08"/>
          <joint name="right_wheel_joint" axis="0 0 1" actuatorfrcrange="-10 10" damping="0.0001"/>
          <geom type="mesh" rgba="0.15 0.15 0.15 1" mesh="right_wheel" contype="0" conaffinity="0"/>
          <geom type="sphere" size="0.008" friction="1.5 0.01 0.0001" rgba="0 0 0 0" group="3"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="left_hip_motor" joint="left_hip_joint" ctrlrange="-10 10"/>
    <motor name="left_wheel_motor" joint="left_wheel_joint" ctrlrange="-10 10"/>
    <motor name="right_hip_motor" joint="right_hip_joint" ctrlrange="-10 10"/>
    <motor name="right_wheel_motor" joint="right_wheel_joint" ctrlrange="-10 10"/>
  </actuator>

  <sensor>
    <framepos name="body_pos" objtype="body" objname="base_link"/>
    <framequat name="body_quat" objtype="body" objname="base_link"/>
    <framelinvel name="body_linvel" objtype="body" objname="base_link"/>
    <frameangvel name="body_angvel" objtype="body" objname="base_link"/>
    <jointpos name="left_hip_pos" joint="left_hip_joint"/>
    <jointvel name="left_hip_vel" joint="left_hip_joint"/>
    <jointpos name="right_hip_pos" joint="right_hip_joint"/>
    <jointvel name="right_hip_vel" joint="right_hip_joint"/>
    <jointpos name="left_wheel_pos" joint="left_wheel_joint"/>
    <jointvel name="left_wheel_vel" joint="left_wheel_joint"/>
    <jointpos name="right_wheel_pos" joint="right_wheel_joint"/>
    <jointvel name="right_wheel_vel" joint="right_wheel_joint"/>
  </sensor>
</mujoco>
